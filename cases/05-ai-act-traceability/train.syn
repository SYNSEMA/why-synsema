intent: "Train the genre classifier with traceability: the engine records every data read, a signed receipt and an EU AI Act data sheet are produced"

-- Run from the repository root (the test signing key goes in through the environment, never in .env or the repo):
--   RECEIPT_SEED=$(tr -d '\r\n' < cases/05-ai-act-traceability/signing_key.hex) synsema run cases/05-ai-act-traceability/train.syn
-- No key yet?  python -c "import secrets; print(secrets.token_hex(32))" > cases/05-ai-act-traceability/signing_key.hex
use "./nb.syn" as nb
require file.read("./cases/05-ai-act-traceability/data/*")
require file.write("./cases/05-ai-act-traceability/results/*")
require sign("RECEIPT_SEED")
require secret("RECEIPT_SEED")

let D be "./cases/05-ai-act-traceability"
let CLASSES be ["mystery", "romance", "fantasy", "fiction", "nonfiction"]

-- 1. Documented data
let labels be csv_parse(read_file(`{D}/data/teacher_labels.csv`))
let usable be where(labels, (e) => e.teacher != nothing and e.teacher != "")
let shuffled be shuffle(rng(11), usable)
let cut be floor(length(shuffled) * 0.8)
let train be slice(shuffled, 0, cut)
let test be slice(shuffled, cut)

-- 2. The off-the-books read: someone added data without documenting it. In Python it escapes the manual
--    manifest; here the engine records it anyway, because the program cannot drop entries from the lineage.
let extra be csv_parse(read_file(`{D}/data/extra_data.csv`))

-- 3. Train and evaluate
let model be nb.train(flatten([apply((b) => {"text": b.title, "y": b.teacher}, train), apply((b) => {"text": b.title, "y": b.teacher}, extra)]), CLASSES)
let hits be length(where(test, (b) => nb.predict(model, b.title).label == b.truth))
let metrics be {"n_train": length(train) + length(extra), "n_test": length(test), "accuracy_vs_truth": round_to(hits / length(test), 4)}
let model_json be json_encode(model)
write_file(`{D}/results/model.json`, model_json)
print(`model trained: {metrics}`)

-- 4. Signed receipt: the engine builds the list of inputs (not the program) and the signature covers the result hash
let k be secret("RECEIPT_SEED")
let did be did_key_encode(ed25519_pubkey(k))
let vm be did + "#" + did_key_decode(did).multibase
let result be {"model_sha256": slice(hex(sha256(model_json)), 2), "metrics": metrics, "classes": CLASSES}
let rec be receipt({"sign": k, "verification_method": vm, "result": result})
write_file(`{D}/results/receipt.json`, json_encode(rec))
write_file(`{D}/results/declared_result.json`, canonical_json(result))
write_file(`{D}/results/issuer.did`, did)

-- 5. Data sheet generated from the lineage (EU AI Act arts. 10-11: origin, preparation, traceability)
let inputs be rec.credentialSubject.inputs
let rows be join(apply((e) => `| {e.source} | \`{e.what}\` | {e.bytes} | \`{slice(e.sha256, 0, 16)}…\` |`, inputs), "\n")
let sheet be `# Data sheet · genre classifier

Generated by the Synsema engine from the run's lineage, not written by hand.

- Issuer (key that signs the receipt): \`{did}\`
- Program (sha256): \`{rec.credentialSubject.program_sha}\`
- Engine: {json_encode(rec.credentialSubject.engine)}
- Model (sha256): \`{result.model_sha256}\`
- Metrics: {json_encode(metrics)}

## Data the run read ({length(inputs)} reads)

| Source | What | Bytes | sha256 |
| --- | --- | --- | --- |
{rows}

## Preparation

- Teacher labels (Jev plus LLM review) filtered to non-empty ones; 80/20 split with seed 11.
- Additional data: \`extra_data.csv\` was added to training ({length(extra)} rows).
`
write_file(`{D}/results/data_sheet.md`, sheet)
print(`receipt signed by {slice(did, 0, 24)}… · {length(inputs)} reads in the lineage`)
each e in inputs
    print(`  {e.source} {e.what} {e.bytes} bytes`)
